{
  "name": "orchestra",
  "version": "0.1.0",
  "private": true,
  "description": "AI Software Development Orchestrator — transform raw ideas into structured, execution-ready development plans",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "clean:all": "pnpm -r clean && rimraf node_modules",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:reset": "node scripts/reset-db.mjs",
    "db:status": "docker compose ps",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
