# Orchestra — Environment Variables
# Copy this file to .env and fill in your values.
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
# All variables listed here are optional at runtime unless noted otherwise.

# --- AI Provider Keys ---
# At least one is needed for AI-powered features to work.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Application ---
NODE_ENV=development
PORT=3000
WEB_PORT=3001
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
# These match the defaults in docker-compose.yml.
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=orchestra_dev
POSTGRES_DB=orchestra
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Worker Queue (future) ---
# REDIS_URL=redis://localhost:6379

# --- Worker ---
WORKER_CONCURRENCY=4
