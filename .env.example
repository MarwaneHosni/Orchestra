# Orchestra — Environment Variables
# Copy this file to .env and fill in your values.
# All variables listed here are optional at runtime unless noted otherwise.

# --- AI Provider Keys ---
# At least one is needed for AI-powered features to work.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (future) ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/orchestra

# --- Worker Queue (future) ---
# REDIS_URL=redis://localhost:6379

# --- Worker ---
WORKER_CONCURRENCY=4
