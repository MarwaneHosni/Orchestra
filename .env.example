# Orchestra — Environment Variables
# Copy this file to .env and fill in your values.
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
# All variables listed here are optional at runtime unless noted otherwise.

# --- Encryption ---
# Used to encrypt AI provider API keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- AI Provider Keys ---
# At least one is needed for AI-powered features to work.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Application ---
NODE_ENV=development
PORT=3000
WEB_PORT=3001
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
# These match the defaults in docker-compose.yml.
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=orchestra_dev
POSTGRES_DB=orchestra
POSTGRES_PORT=5432
# The individual POSTGRES_* vars are used by docker-compose.yml for the container.
# DATABASE_URL is the connection string used by the application. Use literal values here.
DATABASE_URL=postgresql://orchestra:orchestra_dev@localhost:5432/orchestra

# --- SQLite ---
# Path to the SQLite database file.
# SQLITE_DB_PATH=./orchestra.db

# --- Application ---
# URL of the API server used by the frontend (in production or cross-origin setups).
# Leave empty for relative URL mode (works in local dev via Next.js proxy or same-origin).
# NEXT_PUBLIC_API_URL=
