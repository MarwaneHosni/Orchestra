{
  "name": "@orchestra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: use pnpm lint at root'",
    "test": "echo 'test: use pnpm test at root'",
    "clean": "rimraf dist",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- tsx src/db/migrate.ts",
    "db:seed": "dotenv -e ../../.env -- tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:sqlite:generate": "dotenv -e ../../.env -- drizzle-kit generate --config drizzle-sqlite.config.ts",
    "db:sqlite:migrate": "dotenv -e ../../.env -- tsx src/db/migrate-sqlite.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@libsql/client": "^0.17.3",
    "@orchestra/config": "workspace:*",
    "@orchestra/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "sql.js": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "@types/sql.js": "^1.4.11",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
