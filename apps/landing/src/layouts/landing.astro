---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Orchestra — AI-first project planning for developers', description = 'Transform raw ideas into structured, execution-ready development plans. Local-first. Open source. Zero infrastructure.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Orchestra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://orchestra.dev/og-image.png" />
    <meta property="og:url" content={Astro.url} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://orchestra.dev/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Canonical -->
    <link rel="canonical" href={Astro.url} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Theme — set before render to prevent flash -->
    <script is:inline>
      (function() {
        const key = 'orchestra-theme';
        const stored = typeof localStorage !== 'undefined' && localStorage.getItem(key);
        const theme = stored === 'dark' ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        // Sync with Starlight's key so docs pages stay consistent
        if (typeof localStorage !== 'undefined') {
          localStorage.setItem('starlight-theme', theme);
        }
      })();
    </script>

    <Analytics />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @import "../styles/starlight.css";
</style>
