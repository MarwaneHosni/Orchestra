            <ul class="space-y-1">
              <li><a href="/docs/contributing/" class="block px-2 py-1 text-xs" style="color: var(--color-text-secondary);">Contributing</a></li>
            </ul>
          </div>
        </nav>
      </aside>
      <article class="prose min-w-0 flex-1" style="max-width: none;">
        <h1 style="color: var(--color-text-primary); font-family: 'JetBrains Mono', monospace;">{frontmatter.title}</h1>
        <div class="doc-content" set:html={html} />
