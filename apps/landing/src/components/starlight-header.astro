---
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import config from 'virtual:starlight/user-config';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <div class="sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <a href="/docs/overview/" class="orchestra-header-link">Docs</a>
    <a href="https://github.com/orchestra/orchestra" target="_blank" rel="noopener noreferrer" class="orchestra-header-link">
      GitHub<span class="external-arrow">↗</span>
    </a>
    <button id="sl-theme-toggle" class="orchestra-theme-btn" aria-label="Toggle theme">
      <span class="theme-icon-light">☀</span>
      <span class="theme-icon-dark">☾</span>
    </button>
  </div>
</div>

<style>
  @layer starlight.core {
    /* Inner header grid/flex layout (replaces Starlight default Header styles) */
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      /* Prevent long titles overflowing on narrow viewports */
      overflow: clip;
      /* Avoid clipping focus ring around link inside title wrapper */
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    /* Override Starlight's default right-group gap */
    .right-group {
      gap: 0.5rem;
      align-items: center;
    }

    .orchestra-header-link {
      color: var(--color-text-secondary);
      font-size: 0.75rem;
      font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Menlo', monospace;
      font-weight: 500;
      text-decoration: none;
      padding: 0.3rem 0.5rem;
      border-radius: 2px;
      transition: color 0.15s;
    }

    .orchestra-header-link:hover {
      color: var(--color-text-primary);
    }

    .external-arrow {
      font-size: 0.625rem;
      color: var(--color-text-muted);
      margin-left: 0.125rem;
    }

    .orchestra-theme-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 1.5rem;
      height: 1.5rem;
      padding: 0;
      border: none;
      cursor: pointer;
      color: var(--color-text-muted);
      background: none;
      border-radius: 2px;
      font-size: 0.875rem;
      line-height: 1;
      transition: color 0.15s, background 0.15s;
    }

    .orchestra-theme-btn:hover {
      color: var(--color-text-primary);
      background: var(--color-bg-hover);
    }

    @media (min-width: 50rem) {
      .header {
        --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
        --__main-column-fr: calc(
          (
              100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
                (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
                var(--sl-content-width)
            ) / 2
        );
        display: grid;
        grid-template-columns:
          /* 1 (site title): runs up until the main content column's left edge or the width of the title, whichever is the largest */
          minmax(
            calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
            auto
          )
          /* 2 (search box): all free space that is available. */
          1fr
          /* 3 (right items): use the space that these need. */
          auto;
        align-content: center;
      }
    }
  }
</style>

<script is:inline>
  (function() {
    const storageKey = 'orchestra-theme';
    const btn = document.getElementById('sl-theme-toggle');
    const iconLight = btn?.querySelector('.theme-icon-light');
    const iconDark = btn?.querySelector('.theme-icon-dark');

    function updateIcons() {
      if (!iconLight || !iconDark) return;
      const isDark = document.documentElement.dataset.theme === 'dark';
      iconLight.style.display = isDark ? 'inline' : 'none';
      iconDark.style.display = isDark ? 'none' : 'inline';
    }

    function toggleTheme() {
      const current = document.documentElement.dataset.theme;
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      if (typeof localStorage !== 'undefined') {
        localStorage.setItem(storageKey, next);
        localStorage.setItem('starlight-theme', next);
      }
      updateIcons();
    }

    // Initialize icons based on theme already set by ThemeProvider
    updateIcons();
    btn?.addEventListener('click', toggleTheme);
  })();
</script>
